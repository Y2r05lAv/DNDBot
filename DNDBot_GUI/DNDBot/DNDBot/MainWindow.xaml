<Window x:Class="DNDBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent" 
        Title="DNDBot"
        Height="700" Width="1000">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="Transparent"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Britannic Bold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="#333333"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="Transparent"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>

        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Black">
                            <Track Name="PART_Track"
                                IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Background="#404040" BorderBrush="#404040" BorderThickness="10000" Foreground="#404040"  />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Britannic Bold"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        CornerRadius="8"
                        Padding="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="White" BlurRadius="8" ShadowDepth="0"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.75"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.99" ScaleY="0.99"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <DataTrigger Binding="{Binding Tag}" Value="GradientChange">
                </DataTrigger>
            </Style.Triggers>
        </Style>



        <SolidColorBrush x:Key="ButtonForegroundLight" Color="Black"/>
        <SolidColorBrush x:Key="ButtonForegroundDark" Color="White"/>
        <SolidColorBrush x:Key="ButtonBackgroundLight" Color="Transparent"/>
        <SolidColorBrush x:Key="ButtonBackgroundDark" Color="Transparent"/>

         
        <Storyboard x:Key="ThemeTransition">
             
            <ColorAnimation Storyboard.TargetName="ButtonGradientStop1"
                        Storyboard.TargetProperty="Color"
                        Duration="0:0:2"
                        To="Gold"/>
            <ColorAnimation Storyboard.TargetName="ButtonGradientStop1"
                        Storyboard.TargetProperty="Color"
                        Duration="0:0:2"
                        To="Purple"/>
            <ColorAnimation Storyboard.TargetName="ButtonGradientStop1"
                        Storyboard.TargetProperty="Color"
                        Duration="0:0:2"
                        To="Red"/>

            <ColorAnimation Storyboard.TargetName="TextBackground"
                        Storyboard.TargetProperty="Color"
                        Duration="0:0:2"
                        To="Gray" />

            <ColorAnimation Storyboard.TargetName="ConsoleBorder"
                        Storyboard.TargetProperty="Color"
                        Duration="0:0:2"
                        To="Gray"/>
            <ColorAnimation Storyboard.TargetName="TextConsole"
                        Storyboard.TargetProperty="Color"
                        Duration="0:0:2"
                        To="LightGray"/>



             
            <ColorAnimation Storyboard.TargetName="ThemeToggleButton"
                        Storyboard.TargetProperty="(Control.Background).(SolidColorBrush.Color)"
                        Duration="0:0:2"
                        To="Transparent"/>

             
            <ColorAnimation Storyboard.TargetName="ThemeToggleButton"
                        Storyboard.TargetProperty="(Control.Foreground).(SolidColorBrush.Color)"
                        Duration="0:0:2"
                        To="Black"/>

             
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ThemeToggleButton"
                                       Storyboard.TargetProperty="Content"
                                       Duration="0:0:2">
                <DiscreteObjectKeyFrame KeyTime="0:0:1">
                    <DiscreteObjectKeyFrame.Value>☀️</DiscreteObjectKeyFrame.Value>
                </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>


        <Storyboard x:Key="FadeOutButton">
            <DoubleAnimation Storyboard.TargetName="TextBackground"
                     Storyboard.TargetProperty="Opacity"
                     Duration="0:0:2"
                     To="0.65"/>
        </Storyboard>

        <Storyboard x:Key="GetOutButton">
            <DoubleAnimation Storyboard.TargetName="TextBackground"
                     Storyboard.TargetProperty="Opacity"
                     Duration="0:0:2"
                     To="0.90"/>
        </Storyboard>

         
        <Storyboard x:Key="ThemeTransitionDark">
            <ColorAnimation Storyboard.TargetName="ButtonGradientStop1"
                        Storyboard.TargetProperty="Color"
                        Duration="0:0:2"
                        To="DarkGoldenrod"/>
            <ColorAnimation Storyboard.TargetName="ButtonGradientStop1"
                        Storyboard.TargetProperty="Color"
                        Duration="0:0:2"
                        To="DarkMagenta"/>
            <ColorAnimation Storyboard.TargetName="ButtonGradientStop1"
                        Storyboard.TargetProperty="Color"
                        Duration="0:0:2"
                        To="DarkRed"/>
            <ColorAnimation Storyboard.TargetName="TextBackground"
                        Storyboard.TargetProperty="Color"
                        Duration="0:0:2"
                        To="#1a1a1a"/>

            <ColorAnimation Storyboard.TargetName="ConsoleBackground"
                        Storyboard.TargetProperty="Color"
                        Duration="0:0:2"
                        To="#1a1a1a"/>
            <ColorAnimation Storyboard.TargetName="ConsoleBorder"
                        Storyboard.TargetProperty="Color"
                        Duration="0:0:2"
                        To="#2e2e2e"/>
            <ColorAnimation Storyboard.TargetName="TextConsole"
                        Storyboard.TargetProperty="Color"
                        Duration="0:0:2"
                        To="#1f1f1f"/>



             




            <ColorAnimation Storyboard.TargetName="StartBotButton"
                Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                Duration="0:0:2"
                To="White"/>
            <ColorAnimation Storyboard.TargetName="StopBotButton"
                Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                Duration="0:0:2"
                To="White"/>
            <ColorAnimation Storyboard.TargetName="RestartBotButton"
                Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                Duration="0:0:2"
                To="White"/>





            <ColorAnimation Storyboard.TargetName="ThemeToggleButton"
                        Storyboard.TargetProperty="(Control.Foreground).(SolidColorBrush.Color)"
                        Duration="0:0:2"
                        To="White"/>

             
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ThemeToggleButton"
                                       Storyboard.TargetProperty="Content"
                                       Duration="0:0:2">
                <DiscreteObjectKeyFrame KeyTime="0:0:1">
                    <DiscreteObjectKeyFrame.Value>🌙</DiscreteObjectKeyFrame.Value>
                </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>

        <Style x:Key="GradientButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.6,1">
                        <GradientStop x:Name="ButtonGradientStop1" Color="White" Offset="0"/>
                        <GradientStop x:Name="ButtonGradientStop2" Color="LightGray" Offset="0.4"/>
                        <GradientStop x:Name="ButtonGradientStop3" Color="Gray" Offset="2"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

         


        <Style x:Key="ThemeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                             
                            <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="30"
                                BorderBrush="White"
                                BorderThickness="2"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            </Border>

                             
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Grid>

                         
                        <ControlTemplate.Triggers>
                             
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="LightGray"/>
                                <Setter TargetName="ButtonBackground" Property="BorderBrush" Value="Gray"/>
                            </Trigger>

                             
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="Gray"/>
                                <Setter TargetName="ButtonBackground" Property="BorderBrush" Value="DarkGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Window.Resources>

    <Grid x:Name="MainGrid">

        <DockPanel Background="Black" Height="20" VerticalAlignment="Top" MouseLeftButtonDown="MoveWindow">

             
            <Image Source="/logoBot3.ico" Width="15" Height="14" Margin="4,0,0,0" RenderTransformOrigin="0.48,0.96"/>

             
            <TextBlock Text="DNDBot" Margin="3,0,0,0" Foreground="White" VerticalAlignment="Center" FontFamily="Britannic Bold" FontSize="14"/>

             
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="--" Width="30" Foreground="White" Click="MinimizeWindow"/>
                <Button Content="X" Width="30" Foreground="White" Click="CloseWindow"/>
            </StackPanel>
        </DockPanel>





        <Button x:Name="StartBotButton" Content="Start" Foreground="Black"
        Style="{StaticResource GradientButtonStyle}"
        Click="StartButton" Margin="39,194,739,430" Tag="ThemeButton"/>

        <Button x:Name="StopBotButton" Content="Stop" Foreground="Black"
        Style="{StaticResource GradientButtonStyle}"
        Click="StopButton" Margin="38,275,740,349" Tag="ThemeButton"/>

        <Button x:Name="RestartBotButton" Content="Restart" Foreground="Black"
        Style="{StaticResource GradientButtonStyle}"
        Click="RestartButton" Margin="39,356,739,268" Tag="ThemeButton"/>

        <Button x:Name="OpenLogs" Content="📁" Background="Transparent"
        Style="{StaticResource GradientButtonStyle}" VerticalAlignment="Bottom" HorizontalAlignment="Left"
        Click="OpenLogs_Click" Tag="ThemeButton" Height="56" Width="58" Margin="108,0,0,2"/>

        <Button x:Name="OpenConfig" Content="⚙️" Background="Transparent"
        Style="{StaticResource GradientButtonStyle}" VerticalAlignment="Bottom" HorizontalAlignment="Left"
        Click="OpenConfig_Click" Tag="ThemeButton" Height="56" Width="58" Margin="50,0,0,2"/>


        <Border Margin="4,457,706,195" CornerRadius="25">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.6,1">
                    <GradientStop x:Name="ButtonGradientStop10" Color="White" Offset="0"/>
                    <GradientStop x:Name="ButtonGradientStop11" Color="LightGray" Offset="0.4"/>
                    <GradientStop x:Name="ButtonGradientStop12" Color="Gray" Offset="2"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <TextBlock x:Name="TimeLabel" Text="Uptime: 00:00:00" Foreground="White"  TextAlignment="Center"  FontFamily="Britannic Bold"
                   FontSize="15" Margin="-1,0,701,545" Width="300" VerticalAlignment="Bottom"/>

        <TextBlock x:Name="NetworkStatus" Text="Network status: Offline" Foreground="Black"  TextAlignment="Center"  FontFamily="Britannic Bold"
                   FontSize="20" Margin="10,0,712,208" VerticalAlignment="Bottom" Height="22"/>


        <Border Margin="4,510,706,142" CornerRadius="25">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.6,1">
                    <GradientStop x:Name="ButtonGradientStop4" Color="White" Offset="0"/>
                    <GradientStop x:Name="ButtonGradientStop5" Color="LightGray" Offset="0.4"/>
                    <GradientStop x:Name="ButtonGradientStop6" Color="Gray" Offset="2"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <TextBlock x:Name="CpuRamTextBox" Text="CPU: 0% | RAM: 0/0 MB" Foreground="Black"  TextAlignment="Center"  FontFamily="Britannic Bold"
                   FontSize="16" Margin="10,0,712,155" VerticalAlignment="Bottom" Height="22"/>

        <Button x:Name="ThemeToggleButton"
        Content="🌙"
        FontFamily="Britannic Bold"
        FontSize="20"
        Width="40" Height="40"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        Margin="10,0,0,10"
        Click="ToggleTheme"
        FocusVisualStyle="{x:Null}"
        Background="Transparent"
        Foreground="{StaticResource ButtonForegroundDark}"
        Style="{StaticResource ThemeButtonStyle}"/>


        <TextBlock Foreground="White" Text="DND Bot" Margin="0,0,701,580" FontSize="60" FontFamily="Cooper Black" TextAlignment="Center" VerticalAlignment="Bottom" Height="71"/>
        <TextBlock Foreground="White" x:Name="BotStatusText" Text="⚫ Offline" Margin="-1,0,701,562" FontSize="20" FontFamily="Cooper Black" TextAlignment="Center" VerticalAlignment="Bottom"/>

        <Border Width="300" Margin="0,20,700,0" HorizontalAlignment="Left" Panel.ZIndex="-1" BorderBrush="#2e2e2e">
            <Border.Background>
                <SolidColorBrush x:Name="TextBackground" Color="#1a1a1a" Opacity="0.90"/>
            </Border.Background>
        </Border>






        <Border Width="680"  Margin="300,30,0,10" BorderThickness="10">
            <Border.Background>
                <SolidColorBrush x:Name="ConsoleBackground" Color="#1a1a1a" />
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush x:Name="ConsoleBorder" Color="#2e2e2e"/>
            </Border.BorderBrush>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                     
                    <RowDefinition Height="30" />
                     
                </Grid.RowDefinitions>

                 
                <ScrollViewer x:Name="ConsoleScroll" 
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              BorderThickness="0"
              Background="Transparent"
              CanContentScroll="False">
                    <StackPanel x:Name="ConsolePanel">
                    </StackPanel>
                </ScrollViewer>






                 
                <TextBox x:Name="ConsoleInput" Grid.Row="1"
                 Foreground="White" BorderThickness="2" BorderBrush="#030303"
                 FontFamily="Consolas" FontSize="14"
                 KeyDown="ConsoleInput_KeyDown">
                    <TextBox.Background>
                        <SolidColorBrush x:Name="TextConsole" Color="#1f1f1f"/>
                    </TextBox.Background>
                </TextBox>
            </Grid>
        </Border>


        <Grid.Background>
            <LinearGradientBrush StartPoint="0.4,0" EndPoint="0.8,1">
                <GradientStop x:Name="ButtonGradientStop1" Color="DarkGoldenrod" Offset="0"/>
                <GradientStop x:Name="ButtonGradientStop2" Color="DarkMagenta" Offset="0.4"/>
                <GradientStop x:Name="ButtonGradientStop3" Color="DarkREd" Offset="1.5"/>
            </LinearGradientBrush>
        </Grid.Background>

    </Grid>
</Window>
